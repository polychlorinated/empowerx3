---
const nav = [
  { label: 'Home', href: '/' },
  {
    label: 'Education',
    href: '/education',
    children: [
      { label: 'Solutions Library', href: '/education' },
      { label: 'Tired & Foggy Guide', href: '/education/mystery-fatigue' },
      { label: 'Bloated & Crashing Guide', href: '/education/digestion-energy' },
      { label: 'Gut Rebuild', href: '/gut-rebuild' },
      { label: 'Mold Recovery', href: '/mold-recovery' },
    ],
  },
  { label: 'Core Program', href: '/solutions' },
  { label: 'Accelerators', href: '/tools' },
  { label: 'Genetic Meal Prep', href: '/genetic-meal-prep' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string, children?: Array<{ href: string }>) =>
  href === '/'
    ? currentPath === '/'
    : currentPath.startsWith(href) || (children?.some((c) => currentPath.startsWith(c.href)) ?? false);
---

<>
<header id="site-header" class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 h-28">

      <!-- Brand -->
      <a href="/" id="site-logo" class="flex h-[73px] w-[250px] max-w-[calc(100vw-2rem)] shrink-0 items-center justify-center" aria-label="EmpowerX3 home">
        <img src="/empower-logo-full-color.webp" alt="EmpowerX3" width="250" height="73" aria-hidden="true" class="h-full w-full object-fill" />
      </a>

      <!-- Desktop nav: visible at xl and up via pure CSS (no JS required). JS may extend it down to lg when it fits. -->
      <nav id="desktop-nav" aria-label="Primary navigation" class="hidden xl:block min-w-0 flex-1">
        <ul class="flex items-center justify-evenly gap-2" role="list">
          {nav.map((item) => (
            <li class:list={[item.children && 'relative group']}>
              <a
                href={item.href}
                class:list={[
                  'whitespace-nowrap px-3 py-2.5 rounded-md text-base font-medium tracking-wide transition-colors',
                  item.children && 'inline-flex items-center gap-1.5',
                  isActive(item.href, item.children)
                    ? 'text-gold-500 bg-stone-100'
                    : 'text-charcoal hover:text-gold-500 hover:bg-stone-100',
                ]}
                aria-current={isActive(item.href, item.children) ? 'page' : undefined}
                aria-haspopup={item.children ? 'true' : undefined}
              >
                {item.label}
                {item.children && (
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>
              {item.children && (
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 hidden group-hover:block group-focus-within:block z-50">
                  <div class="bg-charcoal rounded-xl border border-stone-700 shadow-2xl py-2 overflow-hidden min-w-[15rem]">
                    <ul role="menu" class="space-y-0.5">
                      {item.children.map((c) => {
                        const active = currentPath === c.href || (c.href !== '/' && currentPath.startsWith(c.href));
                        return (
                          <li role="none">
                            <a
                              href={c.href}
                              role="menuitem"
                              class:list={[
                                'block px-4 py-2.5 text-sm whitespace-nowrap transition-colors',
                                active
                                  ? 'text-gold-500 bg-stone-800'
                                  : 'text-cream-100 hover:bg-stone-800 hover:text-gold-400',
                              ]}
                            >
                              {c.label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Desktop CTA (xl and up) -->
      <a
        href="/contact"
        id="desktop-cta"
        class="hidden xl:inline-flex shrink-0 items-center whitespace-nowrap px-6 py-3 rounded-lg bg-gold-500 text-white text-base font-semibold hover:bg-gold-400 transition-colors"
      >
        Book a Call
      </a>

      <!-- Mobile CTA (below xl) -->
      <a href="/contact" id="mobile-cta" class="hidden sm:inline-flex xl:hidden shrink-0 text-gold-500 font-semibold text-base hover:text-gold-400 transition-colors">
        Book a Call
      </a>

      <!-- Hamburger (below xl) -->
      <button
        id="mobile-menu-toggle"
        class="xl:hidden flex flex-col justify-center items-center w-10 h-10 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2 shrink-0"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-charcoal rounded-full transition-transform duration-200 origin-center" id="hamburger-bar-1"></span>
        <span class="block w-6 h-0.5 bg-charcoal rounded-full mt-1.5 transition-opacity duration-200" id="hamburger-bar-2"></span>
        <span class="block w-6 h-0.5 bg-charcoal rounded-full mt-1.5 transition-transform duration-200 origin-center" id="hamburger-bar-3"></span>
      </button>

    </div>
  </div>
</header>

<!-- Overlay lives OUTSIDE the <header>: the header's backdrop-blur-sm creates a
     CSS containing block, which would collapse a fixed inset-0 child to zero height. -->
<div
  id="mobile-menu"
  class="hidden xl:hidden fixed inset-0 top-28 z-40 bg-charcoal/95 backdrop-blur-sm animate-fade-in overflow-y-auto"
>
    <nav aria-label="Mobile navigation" class="flex flex-col items-center justify-start pt-8 gap-1 px-6 pb-12">
      {nav.map((item) => (
        <div class="w-full">
          <a
            href={item.href}
            class:list={[
              'w-full text-center py-3 text-lg font-medium tracking-wide rounded-lg transition-colors',
              isActive(item.href, item.children)
                ? 'text-gold-500 bg-charcoal-800'
                : 'text-cream-100 hover:text-gold-500 hover:bg-charcoal-800',
            ]}
            aria-current={isActive(item.href, item.children) ? 'page' : undefined}
          >
            {item.label}
          </a>
          {item.children && (
            <ul role="list" class="space-y-1 py-1 border-t border-stone-800">
              {item.children.map((c) => {
                const active = currentPath === c.href || (c.href !== '/' && currentPath.startsWith(c.href));
                return (
                  <li>
                    <a
                      href={c.href}
                      class:list={[
                        'w-full text-center py-2 text-base rounded-lg transition-colors',
                        active
                          ? 'text-gold-500 bg-charcoal-800'
                          : 'text-cream-100/80 hover:text-gold-500 hover:bg-charcoal-800',
                      ]}
                    >
                      {c.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      ))}
      <a
        href="/contact"
        class="mt-4 w-full text-center py-3.5 rounded-lg bg-gold-500 text-white text-lg font-semibold hover:bg-gold-400 transition-colors"
      >
        Book a Call
      </a>
    </nav>
  </div>

<style is:global>
  /* JS enhancement: when the nav demonstrably fits between lg and xl,
     override the Tailwind `hidden`/breakpoint classes. Specificity
     (.nav-desktop #id) beats the single-class utilities. */
  .nav-desktop #desktop-nav { display: block; }
  .nav-desktop #desktop-cta { display: inline-flex; }
  .nav-desktop #mobile-cta,
  .nav-desktop #mobile-menu-toggle { display: none; }
</style>

<script>
  const header = document.getElementById('site-header');
  const desktopNav = document.getElementById('desktop-nav');
  const desktopCta = document.getElementById('desktop-cta');
  const logo = document.getElementById('site-logo');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('hamburger-bar-1');
  const bar2 = document.getElementById('hamburger-bar-2');
  const bar3 = document.getElementById('hamburger-bar-3');

  let menuOpen = false;

  const closeMenu = () => {
    if (!menuOpen) return;
    menuOpen = false;
    if (toggle && menu && bar1 && bar2 && bar3) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      menu.classList.add('hidden');
      bar1.classList.remove('rotate-45', 'translate-y-2');
      bar2.classList.remove('opacity-0');
      bar3.classList.remove('-rotate-45', '-translate-y-2');
      document.body.style.overflow = '';
    }
  };

  if (toggle && menu && bar1 && bar2 && bar3) {
    toggle.addEventListener('click', () => {
      menuOpen = !menuOpen;
      toggle.setAttribute('aria-expanded', String(menuOpen));
      toggle.setAttribute('aria-label', menuOpen ? 'Close menu' : 'Open menu');
      menu.classList.toggle('hidden', !menuOpen);
      bar1.classList.toggle('rotate-45', menuOpen);
      bar1.classList.toggle('translate-y-2', menuOpen);
      bar2.classList.toggle('opacity-0', menuOpen);
      bar3.classList.toggle('-rotate-45', menuOpen);
      bar3.classList.toggle('-translate-y-2', menuOpen);
      document.body.style.overflow = menuOpen ? 'hidden' : '';
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  // Enhancement only: never hides what CSS already shows (xl and up).
  // Between lg and xl, show the full nav when it measurably fits; otherwise
  // leave the CSS defaults (hamburger) in place.
  if (header && desktopNav && desktopCta && logo) {
    const measure = (html: string, forceDisplay?: string) => {
      const wrap = document.createElement('div');
      wrap.style.cssText =
        'position:absolute;visibility:hidden;top:0;left:0;width:0;overflow:visible;white-space:nowrap;pointer-events:none;';
      wrap.innerHTML = html;
      document.body.appendChild(wrap);
      const el = wrap.firstElementChild as HTMLElement | null;
      if (el && forceDisplay) el.style.display = forceDisplay;
      const w = wrap.scrollWidth;
      wrap.remove();
      return w;
    };

    const fits = () => {
      try {
        const inner = header.firstElementChild as HTMLElement | null;
        if (!inner) return false;
        const styles = getComputedStyle(inner);
        const pad = parseFloat(styles.paddingLeft) + parseFloat(styles.paddingRight);
        const navWidth = measure(desktopNav.querySelector('ul')?.outerHTML ?? '');
        const ctaWidth = measure(desktopCta.outerHTML, 'inline-flex');
        const available = inner.clientWidth - pad - logo.offsetWidth - ctaWidth - 48 /* 2 × gap-6 */ - 8 /* safety */;
        return navWidth > 0 && navWidth <= available;
      } catch {
        return false;
      }
    };

    const checkFit = () => {
      const w = window.innerWidth;
      // CSS owns these bands; only enhance between lg and xl
      if (w < 1024 || w >= 1280) {
        header.classList.remove('nav-desktop');
        return;
      }
      header.classList.toggle('nav-desktop', fits());
      if (header.classList.contains('nav-desktop')) closeMenu();
    };

    let raf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(checkFit);
    });

    // Re-check once fonts settle, so measurements reflect real rendering
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => checkFit()).catch(() => {});
    }

    checkFit();
  }
</script>
</>
