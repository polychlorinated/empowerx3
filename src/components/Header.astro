---
const nav = [
  { label: 'Home',       href: '/' },
  { label: 'The Science', href: '/education' },
  { label: 'Core Program',  href: '/solutions' },
  { label: 'Accelerators',    href: '/tools' },
  { label: 'Genetic Meal Prep', href: '/genetic-meal-prep' },
  { label: 'Contact',   href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6 h-28">

      <!-- Brand -->
      <a href="/" class="flex h-[73px] w-[250px] max-w-[calc(100vw-2rem)] shrink-0 items-center justify-center" aria-label="EmpowerX3 home">
        <img src="/empower-logo-full-color.webp" alt="EmpowerX3" width="250" height="73" aria-hidden="true" class="h-full w-full object-fill" />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Primary navigation" class="hidden xl:block min-w-0 flex-1">
        <ul class="flex items-center justify-evenly gap-2" role="list">
          {nav.map(({ label, href }) => {
            const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'whitespace-nowrap px-3 py-2.5 rounded-md text-base font-medium tracking-wide transition-colors',
                    isActive
                      ? 'text-gold-500 bg-stone-100'
                      : 'text-charcoal hover:text-gold-500 hover:bg-stone-100',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Desktop CTA -->
      <a
        href="/contact"
        class="hidden xl:inline-flex shrink-0 items-center whitespace-nowrap px-6 py-3 rounded-lg bg-gold-500 text-white text-base font-semibold hover:bg-gold-400 transition-colors"
      >
        Book a Call
      </a>

      <!-- Mobile CTA -->
      <a href="/contact" class="hidden sm:inline-flex xl:hidden text-gold-500 font-semibold text-base hover:text-gold-400 transition-colors">
        Book a Call
      </a>

      <!-- Hamburger -->
      <button
        id="mobile-menu-toggle"
        class="xl:hidden flex flex-col justify-center items-center w-10 h-10 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-6 h-0.5 bg-charcoal rounded-full transition-transform duration-200 origin-center" id="hamburger-bar-1"></span>
        <span class="block w-6 h-0.5 bg-charcoal rounded-full mt-1.5 transition-opacity duration-200" id="hamburger-bar-2"></span>
        <span class="block w-6 h-0.5 bg-charcoal rounded-full mt-1.5 transition-transform duration-200 origin-center" id="hamburger-bar-3"></span>
      </button>

    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden fixed inset-0 top-28 z-40 bg-charcoal/95 backdrop-blur-sm animate-fade-in"
  >
    <nav aria-label="Mobile navigation" class="flex flex-col items-center justify-start pt-8 gap-2 px-6">
      {nav.map(({ label, href }) => {
        const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
        return (
          <a
            href={href}
            class:list={[
              'w-full text-center py-3 text-lg font-medium tracking-wide rounded-lg transition-colors',
              isActive
                ? 'text-gold-500 bg-charcoal-800'
                : 'text-cream-100 hover:text-gold-500 hover:bg-charcoal-800',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
      <a
        href="/contact"
        class="mt-4 w-full text-center py-3.5 rounded-lg bg-gold-500 text-white text-lg font-semibold hover:bg-gold-400 transition-colors"
      >
        Book a Call
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('hamburger-bar-1');
  const bar2 = document.getElementById('hamburger-bar-2');
  const bar3 = document.getElementById('hamburger-bar-3');
  let open = false;

  toggle.addEventListener('click', () => {
    open = !open;
    toggle.setAttribute('aria-expanded', String(open));

    if (open) {
      menu.classList.remove('hidden');
      bar1.classList.add('rotate-45', 'translate-y-2');
      bar2.classList.add('opacity-0');
      bar3.classList.add('-rotate-45', '-translate-y-2');
      document.body.style.overflow = 'hidden';
    } else {
      menu.classList.add('hidden');
      bar1.classList.remove('rotate-45', 'translate-y-2');
      bar2.classList.remove('opacity-0');
      bar3.classList.remove('-rotate-45', '-translate-y-2');
      document.body.style.overflow = '';
    }
  });

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      toggle.click();
    });
  });
</script>
