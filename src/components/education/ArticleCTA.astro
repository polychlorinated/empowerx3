---
interface Props {
  title: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  body,
  primaryLabel = 'Book a Discovery Call',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="relative bg-brand-800 border-y border-brand-700 py-16 overflow-hidden">
  <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-5" aria-hidden="true"></div>
  <div class="relative max-w-3xl mx-auto px-4 text-center">
    <h2 class="font-heading font-bold text-3xl md:text-4xl text-cream-100 mb-4">{title}</h2>
    {body && <p class="text-brand-300 text-lg leading-relaxed mb-8">{body}</p>}
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={primaryHref}
        class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-gold-500 text-stone-950 font-bold text-lg hover:bg-gold-400 transition-colors"
      >
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="inline-flex items-center justify-center px-8 py-4 rounded-lg border border-brand-500 text-cream-100 font-semibold text-lg hover:border-gold-500 hover:text-gold-400 transition-colors"
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
