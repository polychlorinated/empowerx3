---
interface Props {
  title?: string;
  intro?: string;
  items: string[];
  closing?: string;
}

const { title = 'Does this sound like you?', intro, items, closing } = Astro.props;
---

<section class="bg-stone-100 rounded-2xl border border-stone-200 p-6 md:p-8">
  <h2 class="font-heading font-bold text-2xl md:text-3xl text-stone-900 mb-3">{title}</h2>
  {intro && <p class="text-stone-600 leading-relaxed mb-5">{intro}</p>}
  <ul class="space-y-3 mb-5" role="list">
    {items.map((item) => (
      <li class="flex items-start gap-3 bg-white rounded-xl p-4 border border-stone-200">
        <span class="text-core-teal shrink-0 mt-0.5 font-bold" aria-hidden="true">✓</span>
        <span class="text-stone-600 leading-relaxed">{item}</span>
      </li>
    ))}
  </ul>
  {closing && <p class="text-stone-600 leading-relaxed">{closing}</p>}
</section>
