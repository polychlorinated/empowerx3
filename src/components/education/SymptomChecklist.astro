---
interface Props {
  title?: string;
  intro?: string;
  items: string[];
  closing?: string;
}

const { title = 'Does this sound like you?', intro, items, closing } = Astro.props;
---

<section class="bg-stone-800 rounded-2xl border border-stone-700 p-6 md:p-8">
  <h2 class="font-heading font-bold text-2xl md:text-3xl text-cream-100 mb-3">{title}</h2>
  {intro && <p class="text-stone-400 leading-relaxed mb-5">{intro}</p>}
  <ul class="space-y-3 mb-5" role="list">
    {items.map((item) => (
      <li class="flex items-start gap-3 bg-stone-900 rounded-xl p-4 border border-stone-800">
        <span class="text-gold-500 shrink-0 mt-0.5 font-bold" aria-hidden="true">✓</span>
        <span class="text-stone-300 leading-relaxed">{item}</span>
      </li>
    ))}
  </ul>
  {closing && <p class="text-stone-400 leading-relaxed">{closing}</p>}
</section>
