---
interface Props {
  title?: string;
  articles: Array<{ href: string; title: string; desc: string }>;
}

const { title = 'Keep reading', articles } = Astro.props;
---

<section aria-label="Related articles">
  <h2 class="font-heading font-bold text-2xl md:text-3xl text-cream-100 mb-6">{title}</h2>
  <div class="grid md:grid-cols-3 gap-6">
    {articles.map(({ href, title: articleTitle, desc }) => (
      <a
        href={href}
        class="block bg-stone-800 rounded-2xl p-6 border border-stone-700 hover:border-gold-600 transition-colors group"
      >
        <h3 class="font-heading font-bold text-xl text-cream-100 mb-2 group-hover:text-gold-400 transition-colors leading-snug">
          {articleTitle}
        </h3>
        <p class="text-stone-400 text-sm leading-relaxed mb-3">{desc}</p>
        <span class="text-gold-500 font-semibold text-sm">Read article &rarr;</span>
      </a>
    ))}
  </div>
</section>
