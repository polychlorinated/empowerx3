---
const { short = false } = Astro.props as { short?: boolean };
---

<section class="bg-stone-900" aria-label="Disclaimer">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {!short && (
      <h2 class="font-heading font-bold text-xl text-cream-100 mb-4 text-center">Important disclaimer</h2>
    )}
    <div class="space-y-3 text-stone-500 text-xs leading-relaxed">
      <p>
        <strong class="text-stone-400">EmpowerX3 provides lifestyle coaching, not medical treatment.</strong> Lab work
        and medical decisions are handled by licensed providers. If you have trouble breathing, chest pain, a fever,
        a severe headache, fainting or confusion, seek medical care right away.
      </p>
      <p>
        These statements have not been evaluated by the Food and Drug Administration. Products are not intended to
        diagnose, treat, cure or prevent any disease.
      </p>
    </div>
  </div>
</section>
