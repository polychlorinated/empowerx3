---
import Head from '@/components/Head.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LocalBusiness from '@/components/schema/LocalBusiness.astro';
import WebPage from '@/components/schema/WebPage.astro';

interface Props {
  title: string;
  description: string;
  og?: {
    title?: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
  };
  canonical?: string;
  noindex?: boolean;
  /** Schema.org page type for enhanced structured data */
  schemaPageType?: 'home' | 'service' | 'program' | 'tools' | 'contact' | 'education' | 'article';
  /** Breadcrumb items for BreadcrumbList schema */
  schemaBreadcrumbs?: Array<{ name: string; url: string }>;
  /** Optional full Service schema */
  schemaService?: Record<string, unknown>;
  /** Optional full Article schema */
  schemaArticle?: Record<string, unknown>;
  /** Hero/LCP image to preload on this page (omit to skip the preload) */
  lcpImage?: string;
}

const {
  title,
  description,
  og,
  canonical,
  noindex,
  schemaPageType = 'home',
  schemaBreadcrumbs = [],
  schemaService,
  schemaArticle,
  lcpImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      og={og}
      canonical={canonical}
      noindex={noindex}
      lcpImage={lcpImage}
    />
    <!-- Global schema: LocalBusiness on every page -->
    <LocalBusiness />
    <!-- Page-level schema -->
    <WebPage
      title={title}
      description={description}
      pageType={schemaPageType}
      breadcrumbs={schemaBreadcrumbs}
      service={schemaService}
      article={schemaArticle}
    />
    <!-- Optional page-specific schema (e.g. ContactSchema) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-charcoal text-cream-100 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MKZPN74V"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
