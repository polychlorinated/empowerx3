---
import BaseLayout from '@/layouts/BaseLayout.astro';

const EXOPOD_LINK = 'https://calendar.app.google/gbBP7yTHmfu9YktK9';
---

<BaseLayout
  title="Book an ExoPod Session — EmpowerX3"
  description="Book your ExoPod 10-in-1 cellular recovery session at the EmpowerX3 Longevity Center in Marble Falls, TX. Ten therapies in one 30-minute session."
  og={{
    title: "Book an ExoPod Session — EmpowerX3",
    description: "Reserve your ExoPod 10-in-1 cellular recovery session at the Marble Falls Longevity Center.",
    image: "https://empowerx3.com/exopod1.webp",
    type: "website"
  }}
  canonical="https://empowerx3.com/book-exopod"
  schemaPageType="contact"
  schemaBreadcrumbs={[
    { name: 'Home', url: 'https://empowerx3.com/' },
    { name: 'Accelerators', url: 'https://empowerx3.com/tools' },
    { name: 'Book an ExoPod Session', url: 'https://empowerx3.com/book-exopod' }
  ]}
>

  <!-- ─── Hero ─────────────────────────────────────────────────────── -->
  <section class="relative bg-stone-900 overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-5" aria-hidden="true"></div>
    <div class="absolute -top-20 -right-20 w-72 h-72 bg-gold-900/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <p class="text-gold-500 font-heading font-semibold text-sm uppercase tracking-widest mb-3">Cellular Recovery</p>
      <h1 class="font-heading font-bold text-4xl md:text-6xl mb-6 text-cream-100 leading-tight">
        Book Your ExoPod Session
      </h1>
      <p class="text-stone-300 text-xl max-w-2xl mx-auto leading-relaxed">
        Ten therapies in one 30-minute session at the Longevity Center in Marble Falls, TX.
        Pick a time below and reset your cellular engine.
      </p>
    </div>
  </section>

  <!-- ─── Booking CTA ─────────────────────────────────────────────── -->
  <section class="py-16 bg-cream-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-xl border border-stone-200 shadow-lg p-10 text-center">
        <h2 class="font-heading font-bold text-2xl text-charcoal mb-3">Ready to Reset Your Cellular Engine?</h2>
        <p class="text-stone-600 mb-8">Pick a time on our Google calendar — ten therapies in one 30-minute session.</p>
        <a href={EXOPOD_LINK} target="_blank" rel="noopener" class="inline-flex items-center px-8 py-4 rounded-lg bg-gold-500 text-stone-950 font-bold hover:bg-gold-400 transition-colors">
          Book a Session &rarr;
        </a>
      </div>

      <div class="mt-8 text-center space-y-4">
        <p class="text-stone-600 text-sm">
          Questions first? <a href="mailto:gary@empowerx3.com" class="text-gold-600 hover:text-gold-700 underline underline-offset-2 transition-colors">gary@empowerx3.com</a>
          &nbsp;·&nbsp;
          <a href="/tools#exopod" class="text-gold-600 hover:text-gold-700 underline underline-offset-2 transition-colors">About the ExoPod</a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
