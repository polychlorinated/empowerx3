---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message Received — EmpowerX3"
  description="Thanks for reaching out. Gary will be in touch within one business day."
  og={{
    title: "Message Received — EmpowerX3",
    description: "Thanks for reaching out. Gary will be in touch within one business day.",
    image: "https://empowerx3.com/empower-logo-full.webp",
    type: "website"
  }}
  noindex={true}
  schemaPageType="home"
  schemaBreadcrumbs={[
    { name: 'Home', url: 'https://empowerx3.com/' },
    { name: 'Contact', url: 'https://empowerx3.com/contact' },
    { name: 'Thank You', url: 'https://empowerx3.com/thank-you' }
  ]}
>
  <section class="py-32 text-center px-4 bg-stone-100 min-h-[60vh] flex items-center">
    <div class="max-w-lg mx-auto">
      <span class="text-6xl block mb-6" aria-hidden="true">✅</span>
      <h1 class="font-heading font-bold text-3xl text-stone-900 mb-4">
        You're on the Map
      </h1>
      <p class="text-stone-600 text-lg leading-relaxed mb-8">
        Gary received your message and will personally follow up within one business day.
        In the meantime, take a look at the education section — it'll give you a solid picture
        of what the first few weeks of the program look like.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/education"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-stone-900 text-white font-semibold hover:bg-stone-800 transition-colors"
        >
          Read the Education Guide
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-stone-300 text-stone-900 font-semibold hover:border-core-teal hover:text-core-teal transition-colors"
        >
          Back to Home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
